# Copy to .env in the repository root for local development. Never commit real secrets.
APP_ENV=development
DATABASE_URL=postgresql://agentshield:local-development-only@127.0.0.1:5432/agentshield
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
PUBLIC_RUNS_ENABLED=false
PUBLIC_LLM_ENABLED=false
LLM_PROVIDER=demo

# Docker Compose uses these local-only values. Change them for any shared environment.
POSTGRES_USER=agentshield
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=agentshield
